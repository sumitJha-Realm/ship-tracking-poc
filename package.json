{
  "name": "ship-tracking-poc",
  "version": "1.0.0",
  "description": "High-performance POC for migrating a maritime vessel tracking system from Oracle to MongoDB Atlas",
  "main": "src/api/server.js",
  "scripts": {
    "setup": "node src/indexing/createIndexes.js && node src/seeding/seedData.js",
    "create-indexes": "node src/indexing/createIndexes.js",
    "seed-data": "node src/seeding/seedData.js",
    "start-api": "node src/api/server.js",
    "simulate-ingestion": "node src/simulator/ingestion.js",
    "monitor": "node src/monitoring/monitor.js",
    "start": "concurrently \"npm run start-api\" \"npm run simulate-ingestion\" \"npm run monitor\"",
    "reset": "node src/utils/reset.js",
    "test": "jest",
    "test:load": "node tests/loadTest.js",
    "docker:up": "docker-compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker-compose -f docker/docker-compose.yml down",
    "dev": "nodemon src/api/server.js",
    "start-cdf": "node src/arcgis/cdf-provider/src/standalone-server.js",
    "start-all": "concurrently \"npm run start-api\" \"npm run start-cdf\""
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "mongodb": "^6.3.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.1",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1"
  }
}
